<?xml version="1.0" encoding="utf-8"?>
<!--
  The background layer of the adaptive launcher icon.

  A flat gradient rather than the disc from the logo sheet, because the launcher crops
  this layer to whatever shape it wants — circle, squircle, rounded square — and a disc
  drawn here would have its rim shaved off by that crop. The gradient covers the whole
  108dp so any crop lands on colour, and the three stops are the logo's own: the violet
  it starts from, the blue in the middle, the teal it ends on.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:startX="6"
                android:startY="6"
                android:endX="102"
                android:endY="102"
                android:type="linear">
                <item android:offset="0" android:color="#7C3AED" />
                <item android:offset="0.5" android:color="#2563EB" />
                <item android:offset="1" android:color="#0E9488" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
