<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Only what Android's own XML needs.

      Every string the UI shows now lives in shared/src/commonMain/composeResources, so
      both platforms read one copy and the French translations travel with it. `app_name`
      cannot go there: AndroidManifest references it as @string/app_name, and the manifest
      is resolved by the Android resource system, which knows nothing about Compose
      resources.
    -->
    <string name="app_name">EduNova+</string>
</resources>
